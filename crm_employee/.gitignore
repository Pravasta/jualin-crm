**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/

# Firebase (Phase 5 TD §14) — not committed so the repository isn't tied
# to one Firebase project, and so no habit forms of putting any Firebase
# file in the repo; a real service account JSON would look just like
# these otherwise (acceptance criterion #14). .example files are
# provided instead.
android/app/google-services.json
lib/firebase_options.dart
**/*serviceAccount*.json
# `flutterfire configure`'s own bookkeeping (project id + Firebase app id,
# so a future re-run doesn't re-prompt) — not in TD §14's original list,
# but the same reasoning applies: it names `jualin-crm` explicitly, which
# is exactly the one-project coupling this section exists to avoid.
firebase.json
