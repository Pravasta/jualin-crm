# Salin ke .env.local untuk pengembangan lokal. Jangan pernah commit .env.local.

# crm_be berjalan di http://localhost:8080 secara default (lihat
# docker-compose.yml di akar repo). CORS_ALLOWED_ORIGINS di sana sudah
# menyertakan http://localhost:3000 (issue #30).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Origin that serves the embedded form page and embed.js — crm_be itself
# today (GET /embed/{public_key}, GET /embed.js). Used only to build the
# copy-paste snippet on /connect/form (issue #89). Separate from the API
# base URL because ADR-005 (D1) requires the embed page to move to a
# different hostname from the dashboard once deployment happens; a
# distinct var makes that a config change, not a code change. Falls back
# to NEXT_PUBLIC_API_BASE_URL when unset.
NEXT_PUBLIC_EMBED_BASE_URL=http://localhost:8080
