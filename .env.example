# Salin ke .env untuk pengembangan lokal. Jangan pernah commit .env.
# Referensi lengkap: docs/phases/00-foundation/td.md §3
#
# ⚠️ PENTING — .env TIDAK otomatis terbaca oleh `docker compose up`.
# docker-compose.yml sengaja TIDAK memakai `env_file` (supaya .env yang
# hilang tidak pernah merusak `docker compose up`), dan crm_be membaca
# environment proses, bukan berkas .env. Jadi:
#
#   * Menjalankan lewat `docker compose up`  → nilai diambil dari blok
#     `environment:` di docker-compose.yml. Variabel yang ditulis di sana
#     sebagai ${NAMA:-default} BOLEH ditimpa dari .env (Compose melakukan
#     substitusi variabel dari ./.env); yang ditulis sebagai literal
#     TIDAK terbaca dari .env sama sekali.
#   * Menjalankan `go run ./cmd/api` langsung → muat .env ke shell dulu,
#     mis. `set -a; source .env; set +a`.
#
# Menaruh nilai di .env lalu berharap `docker compose up` memakainya
# adalah jebakan yang sudah pernah terjadi (ENTERPRISE_CONTACT_URL,
# 5 September 2026) — gejalanya fitur diam-diam tidak aktif, tanpa error.

# --- crm_be ---
APP_ENV=development
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s

DATABASE_URL=postgres://jualin:jualin@localhost:5432/jualin_crm?sslmode=disable
DB_MAX_CONNS=10

LOG_LEVEL=debug

# --- Email (issue #63/#64, docs/phases/04.6-email-delivery/td.md §2) ---
# "log" (LogMailer, no real send) or "smtp". Rejected outright at boot
# when APP_ENV=production — a production process that never sends email
# fails completely silently, and LogMailer also writes the verification
# token itself to the log (Rule #26).
MAIL_PROVIDER=smtp
MAIL_FROM=no-reply@jualin.local
# `make dev` runs Mailpit (docker-compose.yml) with its SMTP port mapped
# to localhost:1025 — these values talk to that container from the host.
# Open http://localhost:8025 to read whatever gets sent.
SMTP_HOST=localhost
SMTP_PORT=1025
# starttls (default) or none. Mailpit takes no TLS locally — "none" is
# rejected at boot when APP_ENV=production (Rule #36).
SMTP_TLS=none
SMTP_TIMEOUT=10s

# --- auth (issue #10, docs/phases/01-auth-organization/td.md §2) ---
# Required, min 32 bytes — generate your own, never reuse this one.
JWT_SECRET=development-only-secret-do-not-use-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DASHBOARD=720h
REFRESH_TOKEN_TTL_MOBILE=2160h
# Empty = host-only cookie, correct for localhost.
COOKIE_DOMAIN=
# Must be true when APP_ENV=production — validated at boot (Rule #36).
COOKIE_SECURE=false

# --- CORS (issue #30, docs/phases/03-owner-dashboard/td.md §1) ---
# Comma-separated. Required when APP_ENV=production — validated at boot
# (Rule #36). Never "*" — Access-Control-Allow-Credentials: true forbids it.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Public API (issue #47, docs/phases/04-public-api/td.md §6) ---
# Requests per minute, per api_key. Not a measured number — see TD §6.
PUBLIC_API_RATE_LIMIT=60

# --- Trusted proxies (issue #57, docs/phases/04.5-hardening/td.md §1) ---
# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For/X-Real-IP.
# "none" = no reverse proxy in front of this process, use the raw peer
# address. Required when APP_ENV=production — validated at boot (Rule
# #36). Wrong in either direction breaks per-IP rate limiting (Rule #34).
TRUSTED_PROXIES=none

# --- Push / FCM (issue #68/#73, docs/phases/05-employee-mobile/td.md §9/§13) ---
# "none" (no-op — logged, never sent) or "fcm". Rejected outright at
# boot when APP_ENV=production, same reasoning MAIL_PROVIDER=log is
# rejected there — a production process that silently never pushes
# fails completely quietly. "none" is enough to develop the whole app
# except the one push-delivery issue itself (#73's own td.md §16).
PUSH_PROVIDER=none
# Required when PUSH_PROVIDER=fcm — validated at boot (Rule #36).
# Firebase project id (console.firebase.google.com → Project settings).
FCM_PROJECT_ID=
# Required when PUSH_PROVIDER=fcm. Path to a service account JSON —
# Project settings → Service accounts → Generate new private key.
# NEVER commit this file; keep it outside the repository entirely
# (acceptance criterion #14). See td.md §14 for the full walkthrough.
FCM_CREDENTIALS_FILE=
PUSH_TIMEOUT=10s

# --- Connect: forms (issue #87, docs/phases/06-connect-form/td.md §6/§13) ---
# Required, min 32 bytes — signs the embed page's time-trap token.
# A SEPARATE value from JWT_SECRET on purpose: rotating one must never
# force rotating the other. Generate your own, never reuse this one.
FORM_TOKEN_SECRET=development-only-form-token-secret-do-not-use-in-production
# "none" (always passes) or "turnstile". Rejected outright at boot when
# APP_ENV=production, same reasoning MAIL_PROVIDER=log/PUSH_PROVIDER=none
# are. "none" is enough to develop the whole app except real anti-spam
# verification itself (issue #87's own td.md §14 — needs a Cloudflare
# account).
CAPTCHA_PROVIDER=none
# Required when CAPTCHA_PROVIDER=turnstile — validated at boot (Rule #36).
# dash.cloudflare.com → Turnstile → Add site.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CAPTCHA_TIMEOUT=5s
# Requests per minute — one budget per IP, a SEPARATE budget per form
# (public_key). Not measured numbers — see td.md §6 keputusan D4.
FORM_SUBMIT_RATE_LIMIT_IP=20
FORM_SUBMIT_RATE_LIMIT_FORM=60

# --- Outbound webhook (Phase 7, issue #100) ---
# Relaxes the SSRF deny-list so a private/loopback/link-local address can
# be registered as a webhook target — needed ONLY for local development
# (a receiver on http://localhost). Rejected at boot when
# APP_ENV=production. See crm_be/docs/phases/07-outbound-webhook/td.md §3.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
# Required, min 32 bytes — AES-256-GCM key protecting webhook signing
# secrets at rest (migration 0009). A THIRD value, separate from
# JWT_SECRET and FORM_TOKEN_SECRET on purpose: rotating one must never
# force rotating the others. Generate your own, never reuse this one.
#
# Unlike a hashed credential, this one is REVERSIBLE by design — the
# worker needs the original secret to compute the HMAC that proves an
# outgoing request came from us (td.md §2). Rotating this key makes every
# already-stored signing secret undecryptable; those endpoints must be
# recreated.
WEBHOOK_SECRET_ENC_KEY=development-only-webhook-enc-key-do-not-use-in-production

# --- Outbound webhook worker (Phase 7, issue #102, td.md §9) ---
# The worker is a goroutine inside the api binary, not a separate process.
# false leaves the API fully functional with deliveries piling up as
# pending — correct for an instance that should only serve HTTP while
# another drains the queue. Unlike the flags above this is NOT rejected in
# production: a fleet where EVERY instance sets it false is a deployment
# mistake no single process can detect.
WEBHOOK_WORKER_ENABLED=true
# How often the worker wakes to reap, purge, and claim.
WEBHOOK_WORKER_INTERVAL=10s
# Deliveries claimed per tick. One slow receiver delays its own batch,
# never the queue.
WEBHOOK_WORKER_BATCH=20
# Per-attempt HTTP timeout. Also bounds how long graceful shutdown waits.
WEBHOOK_DELIVERY_TIMEOUT=10s
# Number of RETRIES after the initial send — 5 means up to 6 HTTP calls,
# spaced 1m, 5m, 30m, 2h, 6h (td.md §4.3). Values above 5 are allowed and
# defined: every retry past the table reuses the last delay.
WEBHOOK_MAX_ATTEMPTS=5
# webhook_deliveries is the fastest-growing table in the product (one row
# per lead per endpoint per attempt). Terminal rows older than this are
# deleted lazily from inside the worker loop, throttled to once an hour;
# pending/delivering rows are never deleted at any age (td.md §10).
WEBHOOK_DELIVERY_RETENTION_DAYS=30

# --- Paket berbayar & kuota (Phase 8.5, issue #122–#126) ---
# Gates POST /internal/subscriptions/{organization_id}/plan — the internal
# surface the product owner uses to move a customer between plans after a
# manual transfer. Min 32 bytes if set. EMPTY (the default) means the route
# is NOT REGISTERED AT ALL: a 404, not a 401 on a door nobody can open.
# Never logged (Rule #26), never sent to any client (Rule #23).
# Generate with: openssl rand -hex 32
SUBSCRIPTION_ADMIN_TOKEN=
# Enables POST /v1/subscription/test-checkout — an Owner-triggered upgrade
# to Pro with no real payment behind it, for exercising the paid-plan gates
# before payment service integration lands. Like the token above, false
# means the route is not registered rather than hidden.
# REJECTED AT BOOT when APP_ENV=production: letting every customer upgrade
# themselves for free is not a degraded mode, it's a hole.
SUBSCRIPTION_TEST_CHECKOUT=false
# Where the Enterprise card on the Langganan screen sends someone who wants
# to negotiate (Enterprise never has a checkout — prd 8.5 D4). A FULL URL,
# so switching from WhatsApp to email is an env change and never a code
# change. Only https:// and mailto: are accepted — this value is rendered
# into an href, and the scheme is validated at boot for that reason.
# Empty (the default) renders the card as plain text with NO link, which is
# the honest state until a real destination exists — never a dead button.
#   WhatsApp: https://wa.me/62812XXXXXXX?text=Halo%2C%20saya%20ingin%20tanya%20paket%20Enterprise
#   Email:    mailto:halo@jualin.example
# NOTE: keep a real number in your own .env (gitignored), not here.
ENTERPRISE_CONTACT_URL=
