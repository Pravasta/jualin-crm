{{- /*
Rendered by internal/form/template.go via html/template — NEVER text/template
(TD Phase 6 §7: field labels come from customer input, and this is the one
XSS path in this phase). Every {{.X}} below is escaped contextually by
html/template except AllowedOriginsJSON, which is deliberately
template.JS-typed (already-serialized JSON from encoding/json, not raw
user input) so it's injected as a JS expression rather than a JS string
literal — see template.go's doc comment.
*/ -}}
<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.FormName}}</title>
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 14px;
    color: #1a1a1a;
    padding: 16px;
  }
  .field { margin-bottom: 14px; }
  label { display: block; margin-bottom: 5px; font-weight: 500; }
  input[type="text"], input[type="email"], input[type="tel"], textarea {
    width: 100%;
    padding: 9px 10px;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    font-size: 14px;
    font-family: inherit;
  }
  textarea { min-height: 80px; resize: vertical; }
  input:focus, textarea:focus { outline: 2px solid #ff6b35; outline-offset: 1px; }
  button {
    padding: 10px 22px;
    background: #ff6b35;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  button:hover { background: #e85a28; }
  /* Honeypot — off-screen, not display:none. A bot that only checks
     computed visibility (display/visibility) sometimes skips
     display:none fields but not ones merely positioned off-canvas;
     off-screen positioning catches a wider range of naive fillers
     while a sighted human never sees it either way. */
  .hp { position: absolute; left: -9999px; top: -9999px; }
</style>
</head>
<body>
<form method="post" action="/v1/forms/{{.PublicKey}}/submit">
  {{range .Fields}}
  <div class="field">
    <label for="{{.Key}}">{{.Label}}{{if .Required}} *{{end}}</label>
    {{if eq .Type "textarea"}}
    <textarea id="{{.Key}}" name="{{.Key}}"{{if .Required}} required{{end}}></textarea>
    {{else}}
    <input type="{{.Type}}" id="{{.Key}}" name="{{.Key}}"{{if .Required}} required{{end}}>
    {{end}}
  </div>
  {{end}}
  <div class="hp" aria-hidden="true">
    <label for="website">Website</label>
    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
  </div>
  <input type="hidden" name="form_token" value="{{.FormToken}}">
  {{if .CaptchaEnabled}}
  <div class="cf-turnstile" data-sitekey="{{.TurnstileSiteKey}}"></div>
  {{end}}
  <button type="submit">Kirim</button>
</form>
{{if .CaptchaEnabled}}
<script nonce="{{.Nonce}}" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{{end}}
<script nonce="{{.Nonce}}">
(function () {
  // Auto-resize (keputusan D8) — sends this page's height to whatever
  // parent page embedded it, but ONLY if that parent's origin is one
  // this form's Owner actually allowed. targetOrigin is deliberately
  // never "*": a wildcard would let ANY page that happens to iframe
  // this URL read the message, defeating the whole point of checking
  // an allowlist at all.
  var allowedOrigins = {{.AllowedOriginsJSON}};
  function originOf(url) {
    try { return new URL(url).origin; } catch (e) { return null; }
  }
  var referrerOrigin = document.referrer ? originOf(document.referrer) : null;
  if (!referrerOrigin || allowedOrigins.indexOf(referrerOrigin) === -1) return;

  function sendHeight() {
    parent.postMessage({ type: "jualin:resize", height: document.body.scrollHeight }, referrerOrigin);
  }
  if (typeof ResizeObserver !== "undefined") {
    new ResizeObserver(sendHeight).observe(document.body);
  }
  sendHeight();
})();
</script>
</body>
</html>
